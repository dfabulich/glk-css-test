! Glk CSS Basic Test
! Exercises the CSS Basic property/value set from:
!   https://curiousdannii.github.io/if/glk-proposals.html#css
!   https://intfiction.org/t/glk-extension-proposal-css/66228
!

Constant gestalt_CSSBasic = $1110;

Constant style_Normal = 0;
Constant style_Emphasized = 1;
Constant style_Header = 3;
Constant style_Subheader = 4;
Constant style_Note = 6;
Constant style_BlockQuote = 7;
Constant style_User1 = 9;
Constant style_User2 = 10;

Constant wintype_TextBuffer = 3;

Constant winmethod_Left = $00;
Constant winmethod_Below = $03;
Constant winmethod_Fixed = $10;
Constant winmethod_Proportional = $20;

Constant evtype_LineInput = 3;
Constant evtype_Arrange = 5;

Constant CSS_Span = 0;
Constant CSS_Paragraph = 1;
Constant CSS_Hyperlink = 2;
Constant CSS_Image = 3;      ! reserved (not exercised here)
Constant CSS_Input = 4;
Constant CSS_Window = 5;

Global mainwin;
Global win_demo_flex; ! left-column remainder; always split this, never the last fixed leaf
Global win_demo;      ! packed para/span/num/link demos (the flex pane itself)
Global win_navy;      ! CSS_Window navy — must be its own pane
Global win_span_nocolor; ! opened after color clear (snapshot sibling)
Global win_span_clear;   ! opened after clear_all (snapshot sibling)

! --- Property name buffers --------------------------------------------------

Array p_color buffer "color";
Array p_bgcolor buffer "background-color";
Array p_reverse buffer "-iftf-reverse-video";
Array p_weight buffer "font-weight";
Array p_style buffer "font-style";
Array p_size buffer "font-size";
Array p_family buffer "font-family";
Array p_decor buffer "text-decoration";
Array p_decor_line buffer "text-decoration-line";
Array p_align buffer "text-align";
Array p_margin_l buffer "margin-left";
Array p_margin_r buffer "margin-right";
Array p_indent buffer "text-indent";
Array p_border_style buffer "border-style";

! --- Value buffers: colors --------------------------------------------------

Array v_hash_rgb buffer "#f00";
Array v_hash_rrggbb buffer "#00aa00";
Array v_hash_rrggbbaa buffer "#0000ff80";
Array v_transparent buffer "transparent";
Array v_black buffer "black";
Array v_white buffer "white";
Array v_red buffer "red";
Array v_green buffer "green";
Array v_blue buffer "blue";
Array v_cyan buffer "cyan";
Array v_magenta buffer "magenta";
Array v_yellow buffer "yellow";
Array v_gray buffer "gray";
Array v_grey buffer "grey";
Array v_silver buffer "silver";
Array v_maroon buffer "maroon";
Array v_olive buffer "olive";
Array v_lime buffer "lime";
Array v_aqua buffer "aqua";
Array v_teal buffer "teal";
Array v_navy buffer "navy";
Array v_purple buffer "purple";
Array v_fuchsia buffer "fuchsia";
Array v_orange buffer "orange";
Array v_pink buffer "pink";
Array v_bg_silver buffer "#c0c0c0";

! --- Value buffers: reverse / weight / style / decoration -------------------

Array v_reverse buffer "reverse";
Array v_none buffer "none";
Array v_solid buffer "solid";
Array v_normal buffer "normal";
Array v_bold buffer "bold";
Array v_400 buffer "400";
Array v_700 buffer "700";
Array v_italic buffer "italic";
Array v_oblique buffer "oblique";
Array v_underline buffer "underline";

! --- Value buffers: font-size -----------------------------------------------

Array v_small buffer "small";
Array v_medium buffer "medium";
Array v_large buffer "large";
Array v_larger buffer "larger";
Array v_smaller buffer "smaller";
Array v_pct0 buffer "0%";
Array v_pct50 buffer "50%";
Array v_pct100 buffer "100%";
Array v_pct150 buffer "150%";
Array v_12px buffer "12px";
Array v_18px buffer "18px";
Array v_14pt buffer "14pt";
Array v_em15 buffer "1.5em";
Array v_em2 buffer "2em";

! --- Value buffers: font-family ---------------------------------------------

Array v_serif buffer "serif";
Array v_sans buffer "sans-serif";
Array v_mono buffer "monospace";
Array v_courier buffer "Courier";
Array v_courier_new buffer "'Courier New'";
Array v_courier_list buffer "'Courier New', Courier, monospace";

! --- Value buffers: paragraph -----------------------------------------------

Array v_left buffer "left";
Array v_right buffer "right";
Array v_center buffer "center";
Array v_justify buffer "justify";
Array v_0 buffer "0";
Array v_24px buffer "24px";
Array v_12pt buffer "12pt";

Array event --> 4;
Array line_buffer -> 80;
Array cmd_restart buffer "restart";
Array cmd_quit buffer "quit";
Array cmd_q buffer "q";
Array cmd_input_border_off buffer "input border off";
Array cmd_input_border_on buffer "input border on";
Array cmd_input_border_clear buffer "input border clear";

! --- Glk entry points -------------------------------------------------------

[ glk_exit;
	glk($0001);
];

[ glk_gestalt sel val;
	return glk($0004, sel, val);
];

[ glk_window_open split method size wintype rock;
	return glk($0023, split, method, size, wintype, rock);
];

[ glk_window_close win;
	glk($0024, win, 0);
];

[ glk_window_clear win;
	glk($002A, win);
];

[ glk_set_window win;
	glk($002F, win);
];

[ glk_set_style styl;
	glk($0086, styl);
];

[ glk_select ev;
	glk($00C0, ev);
];

[ glk_request_line_event win buf maxlen initlen;
	glk($00D0, win, buf, maxlen, initlen);
];

[ glk_cancel_line_event win ev;
	glk($00D1, win, ev);
];

[ glk_css_hint_set wintype csstarget styl prop proplen val vallen;
	glk($1110, wintype, csstarget, styl, prop, proplen, val, vallen);
];

[ glk_css_hint_set_num wintype csstarget styl prop proplen val;
	glk($1111, wintype, csstarget, styl, prop, proplen, val);
];

[ glk_css_hint_clear wintype csstarget styl prop proplen;
	glk($1112, wintype, csstarget, styl, prop, proplen);
];

[ glk_css_hint_clear_all_by_style wintype styl;
	glk($1116, wintype, styl);
];

[ glk_css_hint_clear_all_by_window wintype;
	glk($1117, wintype);
];

[ glk_css_inline_set csstarget prop proplen val vallen;
	glk($1113, csstarget, prop, proplen, val, vallen);
];

[ glk_css_inline_set_num csstarget prop proplen val;
	glk($1114, csstarget, prop, proplen, val);
];

[ glk_css_inline_clear csstarget prop proplen;
	glk($1115, csstarget, prop, proplen);
];

[ glk_set_hyperlink linkval;
	glk($0100, linkval);
];

! --- Helpers: buffer arrays are (len word) + bytes --------------------------

[ BufPtr arr; return arr + 4; ];
[ BufLen arr; return arr-->0; ];

[ CssInline prop val;
	glk_css_inline_set(CSS_Span, BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssInlinePara prop val;
	glk_css_inline_set(CSS_Paragraph, BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssInlineLink prop val;
	glk_css_inline_set(CSS_Hyperlink, BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssInlineNum prop val;
	glk_css_inline_set_num(CSS_Span, BufPtr(prop), BufLen(prop), val);
];

[ CssClear prop;
	glk_css_inline_clear(CSS_Span, BufPtr(prop), BufLen(prop));
];

[ CssClearPara prop;
	glk_css_inline_clear(CSS_Paragraph, BufPtr(prop), BufLen(prop));
];

[ CssClearLink prop;
	glk_css_inline_clear(CSS_Hyperlink, BufPtr(prop), BufLen(prop));
];

[ CssHintSpan styl prop val;
	glk_css_hint_set(wintype_TextBuffer, CSS_Span, styl,
		BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssHintPara styl prop val;
	glk_css_hint_set(wintype_TextBuffer, CSS_Paragraph, styl,
		BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssHintLink styl prop val;
	glk_css_hint_set(wintype_TextBuffer, CSS_Hyperlink, styl,
		BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssHintClearSpan styl prop;
	glk_css_hint_clear(wintype_TextBuffer, CSS_Span, styl,
		BufPtr(prop), BufLen(prop));
];

[ CssHintClearPara styl prop;
	glk_css_hint_clear(wintype_TextBuffer, CSS_Paragraph, styl,
		BufPtr(prop), BufLen(prop));
];

[ CssWindow prop val;
	glk_css_hint_set(wintype_TextBuffer, CSS_Window, style_Normal,
		BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssWindowClear prop;
	glk_css_hint_clear(wintype_TextBuffer, CSS_Window, style_Normal,
		BufPtr(prop), BufLen(prop));
];

[ CssInput prop val;
	glk_css_hint_set(wintype_TextBuffer, CSS_Input, style_Normal,
		BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssInlineInput prop val;
	glk_css_inline_set(CSS_Input, BufPtr(prop), BufLen(prop), BufPtr(val), BufLen(val));
];

[ CssClearInput prop;
	glk_css_inline_clear(CSS_Input, BufPtr(prop), BufLen(prop));
];

! Left column (50% width) for demos; mainwin stays on the right at full height.
[ BeginDemoColumn;
	win_demo_flex = glk_window_open(mainwin, winmethod_Left + winmethod_Proportional, 50,
		wintype_TextBuffer, 0);
	return win_demo_flex;
];

! Peel a fixed-height strip from the bottom of the left-column remainder.
! Always split win_demo_flex (not the previous strip) — splitting a fixed leaf
! leaves that leaf at height 0 and produces tiny/unreadable demos.
[ OpenDemoLines lines;
	return glk_window_open(win_demo_flex, winmethod_Below + winmethod_Fixed, lines,
		wintype_TextBuffer, 0);
];

! Label + styled hyperlink + adjacent plain hyperlink for easy compare.
[ LinkSample expect_label prop val;
	print "EXPECT ", (string) expect_label, ": ";
	CssInlineLink(prop, val);
	glk_set_hyperlink(1);
	print "THIS LINK";
	glk_set_hyperlink(0);
	CssClearLink(prop);
	print "   |   plain: ";
	glk_set_hyperlink(2);
	print "THIS LINK";
	glk_set_hyperlink(0);
	new_line;
];

[ Section title;
	new_line;
	glk_set_style(style_Header);
	print (string) title;
	new_line;
	glk_set_style(style_Normal);
];

[ SubSection title;
	glk_set_style(style_Subheader);
	print (string) title;
	new_line;
	glk_set_style(style_Normal);
];

! Label in Normal, then sample text with one inline property applied.
[ Sample1 label prop val;
	print (string) label, ": ";
	CssInline(prop, val);
	print "Sample text";
	CssClear(prop);
	new_line;
];

! Label + sample with two inline properties (e.g. color + background).
[ Sample2 label p1 v1 p2 v2;
	print (string) label, ": ";
	CssInline(p1, v1);
	CssInline(p2, v2);
	print "Sample text";
	CssClear(p1);
	CssClear(p2);
	new_line;
];

! Named-color swatch: colored text on a light silver background.
[ ColorSwatch name val;
	print (string) name, ": ";
	CssInline(p_bgcolor, v_bg_silver);
	CssInline(p_color, val);
	print "##### ";
	print (string) name;
	print " #####";
	CssClear(p_color);
	CssClear(p_bgcolor);
	new_line;
];

! Case-folded match of the completed line against a buffer-array command word.
[ LineMatches cmd   i len ch1 ch2 cmdbytes;
	len = event-->2;
	if (len ~= BufLen(cmd)) rfalse;
	cmdbytes = BufPtr(cmd);
	for (i = 0 : i < len : i++) {
		ch1 = line_buffer->i;
		if (ch1 >= 'A' && ch1 <= 'Z') ch1 = ch1 + 32;
		ch2 = cmdbytes->i;
		if (ch2 >= 'A' && ch2 <= 'Z') ch2 = ch2 + 32;
		if (ch1 ~= ch2) rfalse;
	}
	rtrue;
];

[ CloseAllDemos;
	if (win_demo) { glk_window_close(win_demo); win_demo = 0; }
	if (win_navy) { glk_window_close(win_navy); win_navy = 0; }
	if (win_span_nocolor) { glk_window_close(win_span_nocolor); win_span_nocolor = 0; }
	if (win_span_clear) { glk_window_close(win_span_clear); win_span_clear = 0; }
	win_demo_flex = 0;
	glk_set_window(mainwin);
];

[ CloseSplitWindows;
	CloseAllDemos();
];

[ ClearHintState;
	glk_css_hint_clear_all_by_window(wintype_TextBuffer);
];

[ PrintPrompt;
	new_line;
	print "Commands: restart, quit, input border on|off|clear.^";
	print "(Listening for arrange — e.g. toggle ~Games can set colors and styles~.)^";
	print "EXPECT: CSS_Input border from hint (solid) unless overridden by inline.^";
	print "> ";
];

! Returns 1 = quit, 2 = restart. Handles arrange by noting it and re-prompting.
[ CommandLoop   done;
	done = 0;
	PrintPrompt();
	while (~~done) {
		glk_request_line_event(mainwin, line_buffer, 80, 0);
		glk_select(event);
		if (event-->0 == evtype_Arrange) {
			glk_cancel_line_event(mainwin, event);
			new_line;
			print "[arrange — theme/styles may have changed; existing text is^";
			print " restyled by the interpreter. Type restart to re-run samples.]^";
			PrintPrompt();
			continue;
		}
		if (event-->0 ~= evtype_LineInput) continue;
		if (LineMatches(cmd_quit) || LineMatches(cmd_q)) {
			done = 1;
			continue;
		}
		if (LineMatches(cmd_restart)) {
			done = 2;
			continue;
		}
		if (LineMatches(cmd_input_border_off)) {
			CssInlineInput(p_border_style, v_none);
			print "[CSS_Input inline border-style:none]^";
			print "> ";
			continue;
		}
		if (LineMatches(cmd_input_border_on)) {
			CssInlineInput(p_border_style, v_solid);
			print "[CSS_Input inline border-style:solid]^";
			print "> ";
			continue;
		}
		if (LineMatches(cmd_input_border_clear)) {
			CssClearInput(p_border_style);
			print "[CSS_Input inline border-style cleared (hint applies again)]^";
			print "> ";
			continue;
		}
		print "Unknown command. Try restart, quit, or input border on|off|clear.^";
		print "> ";
	}
	return done;
];

[ RunTests;

	print "CSS BASIC TEST BEGIN^";
	print "gestalt_CSSBasic / function IDs: 0x1110-0x1118^";
	print "(CSS_Image=", CSS_Image, " reserved / not exercised; CSS_Input=", CSS_Input,
		" border-style set before mainwin open.)^";

	! ======================================================================
	Section("1. Inline color");

	Sample1("color #rgb (#f00)", p_color, v_hash_rgb);
	Sample1("color #rrggbb (#00aa00)", p_color, v_hash_rrggbb);
	Sample1("color #rrggbbaa (#0000ff80, expect translucent blue)",
		p_color, v_hash_rrggbbaa);

	SubSection("Named colors (text on silver)");
	ColorSwatch("transparent (expect invisible / no color)", v_transparent);
	ColorSwatch("black", v_black);
	ColorSwatch("white", v_white);
	ColorSwatch("red", v_red);
	ColorSwatch("green", v_green);
	ColorSwatch("blue", v_blue);
	ColorSwatch("cyan", v_cyan);
	ColorSwatch("magenta", v_magenta);
	ColorSwatch("yellow", v_yellow);
	ColorSwatch("gray", v_gray);
	ColorSwatch("grey", v_grey);
	ColorSwatch("silver", v_silver);
	ColorSwatch("maroon", v_maroon);
	ColorSwatch("olive", v_olive);
	ColorSwatch("lime", v_lime);
	ColorSwatch("aqua", v_aqua);
	ColorSwatch("teal", v_teal);
	ColorSwatch("navy", v_navy);
	ColorSwatch("purple", v_purple);
	ColorSwatch("fuchsia", v_fuchsia);
	ColorSwatch("orange", v_orange);
	ColorSwatch("pink", v_pink);

	! ======================================================================
	Section("2. Inline background-color");

	Sample2("bg #rgb on black text", p_color, v_black, p_bgcolor, v_hash_rgb);
	Sample2("bg #rrggbb", p_color, v_black, p_bgcolor, v_hash_rrggbb);
	Sample2("bg #rrggbbaa (#0000ff80)", p_color, v_black, p_bgcolor, v_hash_rrggbbaa);
	Sample2("bg named yellow", p_color, v_black, p_bgcolor, v_yellow);
	Sample2("bg transparent (no fill)", p_color, v_red, p_bgcolor, v_transparent);

	! ======================================================================
	Section("3. Inline -iftf-reverse-video");

	print "baseline (black on white, no reverse): ";
	CssInline(p_color, v_black);
	CssInline(p_bgcolor, v_white);
	print "Sample text";
	CssClear(p_color);
	CssClear(p_bgcolor);
	new_line;
	print "reverse (expect white on black): ";
	CssInline(p_color, v_black);
	CssInline(p_bgcolor, v_white);
	CssInline(p_reverse, v_reverse);
	print "Sample text";
	CssClear(p_reverse);
	CssClear(p_color);
	CssClear(p_bgcolor);
	new_line;
	print "none (expect black on white): ";
	CssInline(p_color, v_black);
	CssInline(p_bgcolor, v_white);
	CssInline(p_reverse, v_none);
	print "Sample text";
	CssClear(p_reverse);
	CssClear(p_color);
	CssClear(p_bgcolor);
	new_line;

	print "baseline (default theme colors, no reverse): ";
	CssClear(p_color);
	CssClear(p_bgcolor);
	print "Sample text";
	new_line;
	print "reverse with no fg/bg (expect inverted theme colors): ";
	CssClear(p_color);
	CssClear(p_bgcolor);
	CssInline(p_reverse, v_reverse);
	print "Sample text";
	CssClear(p_reverse);
	new_line;

	SubSection("Multi-line reverse (span background)");
	print "(Expect white-on-black glyph fills that follow the wrapped runs, not a full content-box bar.)^";
	CssInline(p_color, v_black);
	CssInline(p_bgcolor, v_white);
	CssInline(p_reverse, v_reverse);
	print "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump. The five boxing wizards jump quickly.^";
	CssClear(p_reverse);
	CssClear(p_color);
	CssClear(p_bgcolor);

	! ======================================================================
	Section("4. Inline font-weight");

	Sample1("normal", p_weight, v_normal);
	Sample1("bold", p_weight, v_bold);
	Sample1("400 (= normal)", p_weight, v_400);
	Sample1("700 (= bold)", p_weight, v_700);
	print "set_num 400: ";
	CssInlineNum(p_weight, 400);
	print "Sample text";
	CssClear(p_weight);
	new_line;
	print "set_num 700: ";
	CssInlineNum(p_weight, 700);
	print "Sample text";
	CssClear(p_weight);
	new_line;

	! ======================================================================
	Section("5. Inline font-style");

	Sample1("normal", p_style, v_normal);
	Sample1("italic", p_style, v_italic);
	Sample1("oblique", p_style, v_oblique);

	! ======================================================================
	Section("6. Inline font-size");

	Sample1("small", p_size, v_small);
	Sample1("medium", p_size, v_medium);
	Sample1("large", p_size, v_large);
	Sample1("larger", p_size, v_larger);
	Sample1("smaller", p_size, v_smaller);
	Sample1("0%", p_size, v_pct0);
	Sample1("50%", p_size, v_pct50);
	Sample1("100%", p_size, v_pct100);
	Sample1("150%", p_size, v_pct150);
	Sample1("12px", p_size, v_12px);
	Sample1("18px", p_size, v_18px);
	Sample1("14pt", p_size, v_14pt);
	Sample1("1.5em", p_size, v_em15);

	! ======================================================================
	Section("7. Inline font-family");

	Sample1("serif", p_family, v_serif);
	Sample1("sans-serif", p_family, v_sans);
	Sample1("monospace", p_family, v_mono);
	Sample1("Courier", p_family, v_courier);
	Sample1("'Courier New'", p_family, v_courier_new);
	Sample1("'Courier New', Courier, monospace", p_family, v_courier_list);

	! ======================================================================
	Section("8. Inline text-decoration / text-decoration-line");

	Sample1("text-decoration underline", p_decor, v_underline);
	Sample1("text-decoration none", p_decor, v_none);
	Sample1("text-decoration-line underline", p_decor_line, v_underline);
	Sample1("text-decoration-line none", p_decor_line, v_none);

	! Combined span styles
	SubSection("Combined inline styles");
	print "bold+italic+underline+red+large: ";
	CssInline(p_weight, v_bold);
	CssInline(p_style, v_italic);
	CssInline(p_decor, v_underline);
	CssInline(p_color, v_red);
	CssInline(p_size, v_large);
	print "Sample text";
	CssClear(p_weight);
	CssClear(p_style);
	CssClear(p_decor);
	CssClear(p_color);
	CssClear(p_size);
	new_line;

	! ======================================================================
	Section("9. Inline paragraph text-align (CSS_Paragraph)");
	print "(Inline paragraph styles apply to the next block; each sample is its own line.)^";

	CssInlinePara(p_align, v_left);
	print "text-align:left — The quick brown fox jumps over the lazy dog.^";
	CssClearPara(p_align);

	CssInlinePara(p_align, v_right);
	print "text-align:right — The quick brown fox jumps over the lazy dog.^";
	CssClearPara(p_align);

	CssInlinePara(p_align, v_center);
	print "text-align:center — The quick brown fox jumps over the lazy dog.^";
	CssClearPara(p_align);

	CssInlinePara(p_align, v_justify);
	print "text-align:justify — The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump.^";
	CssClearPara(p_align);

	! ======================================================================
	Section("10–15. Packed left-column demo (open after all hints set)");
	print "(Like stylehints: css_hint_set only affects windows opened AFTER.^";
	print " Already-open windows keep their creation-time snapshot.)^";
	print "(One tall LEFT demo holds para+span+num+link; only navy/snapshot strips peel off.)^";

	! Paragraph hints (§10)
	CssHintPara(style_User1, p_align, v_left);
	CssHintPara(style_User1, p_bgcolor, v_yellow);
	CssHintPara(style_User2, p_align, v_right);
	CssHintPara(style_BlockQuote, p_align, v_center);
	CssHintPara(style_BlockQuote, p_bgcolor, v_cyan);
	CssHintPara(style_Note, p_align, v_justify);
	CssHintPara(style_Note, p_margin_l, v_24px);
	CssHintPara(style_Note, p_margin_r, v_24px);
	CssHintPara(style_Note, p_bgcolor, v_pink);
	CssHintPara(style_Header, p_indent, v_em2);
	CssHintPara(style_Subheader, p_indent, v_em15);
	CssHintPara(style_Emphasized, p_margin_l, v_12pt);
	CssHintPara(style_Emphasized, p_indent, v_0);
	CssHintPara(style_Normal, p_bgcolor, v_silver);

	! Span hints (§11 full) + set_num (§12) + hyperlink hints (§15) — same snapshot window
	CssHintSpan(style_User1, p_color, v_purple);
	CssHintSpan(style_User1, p_weight, v_bold);
	CssHintSpan(style_User1, p_decor, v_underline);
	glk_css_hint_set_num(wintype_TextBuffer, CSS_Span, style_User2,
		BufPtr(p_weight), BufLen(p_weight), 700);
	CssHintLink(style_Normal, p_color, v_orange);
	CssHintLink(style_Normal, p_weight, v_bold);
	CssHintLink(style_User1, p_color, v_lime);
	CssHintLink(style_User1, p_style, v_italic);

	glk_set_style(style_User1);
	print "CONTROL mainwin User1: NO yellow/purple/bold/underline from hints.^";
	glk_set_style(style_User2);
	print "CONTROL mainwin User2: NOT bold from set_num.^";
	glk_set_style(style_Normal);
	print "CONTROL mainwin Normal link: ";
	glk_set_hyperlink(10);
	print "THIS LINK";
	glk_set_hyperlink(0);
	print " — should NOT be orange/bold from hyperlink hints.^";

	win_demo = BeginDemoColumn();
	glk_set_window(win_demo);
	glk_set_style(style_Header);
	print "LEFT DEMO (packed hints)^";
	glk_set_style(style_Normal);

	SubSection("10. Paragraph");
	print "EXPECT silver bar behind this whole Normal line.^";
	glk_set_style(style_User1);
	print "EXPECT yellow bar + left-aligned User1 (also purple+bold+underline from span).^";
	glk_set_style(style_User2);
	print "EXPECT right-aligned User2 + bold (weight 700).^";
	glk_set_style(style_BlockQuote);
	print "EXPECT cyan bar + centered BlockQuote line.^";
	glk_set_style(style_Note);
	print "EXPECT pink bar + justified Note with side margins — The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.^";
	glk_set_style(style_Header);
	print "EXPECT Header first line indented ~2em.^";
	glk_set_style(style_Subheader);
	print "EXPECT Subheader first line indented ~1.5em.^";
	glk_set_style(style_Emphasized);
	print "EXPECT Emphasized body indented (margin-left), first line flush with body.^";
	glk_set_style(style_Normal);

	SubSection("Multi-line reverse (paragraph background)");
	print "EXPECT full-width inverted bars (not glyph-only), wrapping with the text:^";
	glk_set_style(style_User1);
	CssInline(p_reverse, v_reverse);
	print "Yellow para + reverse: The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump.^";
	CssClear(p_reverse);
	glk_set_style(style_Normal);
	CssInline(p_reverse, v_reverse);
	print "Silver para + reverse: The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump.^";
	CssClear(p_reverse);

	SubSection("11. Span User1");
	glk_set_style(style_User1);
	print "EXPECT User1: purple AND bold AND underlined (yellow para bar too).^";
	glk_set_style(style_Normal);
	print "Normal (for compare): not purple/bold/underlined.^";

	SubSection("12. set_num User2");
	glk_set_style(style_User2);
	print "EXPECT User2: bold (weight 700), right-aligned.^";
	glk_set_style(style_Normal);
	print "Normal (for compare): not bold from that hint.^";

	SubSection("15. Hyperlink hints");
	glk_set_style(style_Normal);
	print "EXPECT orange+bold: ";
	glk_set_hyperlink(11);
	print "THIS LINK";
	glk_set_hyperlink(0);
	print "   |   plain Normal text (not a link).^";
	glk_set_style(style_User1);
	print "EXPECT lime+italic link: ";
	glk_set_hyperlink(12);
	print "THIS LINK";
	glk_set_hyperlink(0);
	print "   |   plain User1 (purple+bold+underline, not a link).^";
	glk_set_style(style_Normal);
	glk_set_window(mainwin);
	print "(Packed left demo stays open. Small strips below it are navy + span snapshots.)^";

	! ======================================================================
	Section("10b. CSS_Window hints (own pane — open after set)");
	print "(CSS_Window styles the window chrome/pane, not individual paragraphs.)^";

	! Drop leftover Normal silver so it cannot paint over the navy pane.
	CssHintClearPara(style_Normal, p_bgcolor);
	CssHintClearPara(style_User1, p_bgcolor);
	CssWindow(p_bgcolor, v_navy);
	CssWindow(p_color, v_white);

	win_navy = OpenDemoLines(2);
	glk_set_window(win_navy);
	print "10b. CSS_Window navy^";
	glk_set_window(mainwin);

	CssWindowClear(p_bgcolor);
	CssWindowClear(p_color);

	! ======================================================================
	Section("11b. Span snapshot siblings (open after each clear)");
	print "(Packed demo keeps its snapshot; these strips open under the new hint state.)^";

	CssHintClearSpan(style_User1, p_color);

	glk_set_window(win_demo);
	glk_set_style(style_User1);
	print "STILL EXPECT purple (snapshot): clearing color later does not restyle this window.^";
	glk_set_style(style_Normal);
	glk_set_window(mainwin);

	win_span_nocolor = OpenDemoLines(2);
	glk_set_window(win_span_nocolor);
	glk_set_style(style_User1);
	print "11b. color clear EXPECT: bold+underline, NOT purple^";
	glk_set_style(style_Normal);
	glk_set_window(mainwin);

	glk_css_hint_clear_all_by_style(wintype_TextBuffer, style_User1);

	win_span_clear = OpenDemoLines(2);
	glk_set_window(win_span_clear);
	glk_set_style(style_User1);
	print "11b. clear_all EXPECT: library defaults.^";
	glk_set_style(style_Normal);
	glk_set_window(mainwin);

	! ======================================================================
	Section("13. Inline clear");

	CssInline(p_color, v_orange);
	CssInline(p_weight, v_bold);
	print "EXPECT orange+bold: Sample";
	new_line;
	CssClear(p_color);
	print "EXPECT bold only (color cleared): Sample";
	CssClear(p_weight);
	new_line;

	! ======================================================================
	Section("14. Inline CSS_Hyperlink (styles next hyperlink)");
	print "(Each line: styled THIS LINK | plain THIS LINK for comparison.)^";

	LinkSample("red", p_color, v_red);
	LinkSample("green (#00aa00)", p_color, v_hash_rrggbb);
	LinkSample("bold", p_weight, v_bold);
	LinkSample("italic", p_style, v_italic);
	LinkSample("yellow background", p_bgcolor, v_yellow);
	LinkSample("no underline (text-decoration:none)", p_decor, v_none);
	LinkSample("no underline (text-decoration-line:none)", p_decor_line, v_none);

	print "EXPECT fuchsia+bold+underline: ";
	CssInlineLink(p_color, v_fuchsia);
	CssInlineLink(p_weight, v_bold);
	CssInlineLink(p_decor, v_underline);
	glk_set_hyperlink(2);
	print "THIS LINK";
	glk_set_hyperlink(0);
	CssClearLink(p_color);
	CssClearLink(p_weight);
	CssClearLink(p_decor);
	print "   |   plain: ";
	glk_set_hyperlink(3);
	print "THIS LINK";
	glk_set_hyperlink(0);
	new_line;

	new_line;
	print "CSS BASIC TEST END^";
];

[ Main
	supported cmd;

	@setiosys 2 0; ! select Glk I/O system

	! CSS_Input is snapshotted at window open (style arg ignored).
	CssInput(p_border_style, v_solid);

	mainwin = glk_window_open(0, 0, 0, wintype_TextBuffer, 0);
	glk_set_window(mainwin);
	win_demo_flex = 0;
	win_demo = 0;
	win_navy = 0;
	win_span_nocolor = 0;
	win_span_clear = 0;

	supported = glk_gestalt(gestalt_CSSBasic, 0);
	print "gestalt_CSSBasic => ", supported, "^";
	if (~~supported) {
		print "CSS Basic not available; nothing further to exercise.^";
		print "CSS BASIC TEST END^";
		while (CommandLoop() == 2) {
			glk_window_clear(mainwin);
			print "gestalt_CSSBasic => ", supported, "^";
			print "CSS Basic not available; nothing further to exercise.^";
			print "CSS BASIC TEST END^";
		}
		glk_exit();
	}

	while (1) {
		RunTests();
		cmd = CommandLoop();
		if (cmd == 1) break; ! quit
		! restart: tear down splits, clear hints + main window, re-run
		CloseSplitWindows();
		ClearHintState();
		glk_window_clear(mainwin);
	}
	glk_exit();
];
